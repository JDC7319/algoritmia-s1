Algoritmo PromedioNotas
	Definir nota1 Como Real
	Definir nota2 Como Real
	Definir nota3 Como Real
	
	
	
	Escribir "Porfa Coloca tus Notas /3/"
	
	Escribir "Nota 1"
	Leer nota1
	
	Escribir "Nota 2"
	Leer nota2
	
	Escribir "Nota 3"
	Leer nota3
	
	promedion<-(nota1+nota2+nota3)/3
	
	Escribir "Tu promedio de notas es: " ,promedion, ":D"
	
FinAlgoritmo
